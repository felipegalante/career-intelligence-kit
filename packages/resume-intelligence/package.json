{
  "name": "@career-intelligence/resume-intelligence",
  "version": "0.0.0",
  "description": "Deterministic resume parsing, evidence matching, fit scoring, gap analysis, and Job Match Report building.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@career-intelligence/fit-scoring": "workspace:*",
    "@career-intelligence/job-description-normalization": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "vitest": "^2.1.8"
  }
}
